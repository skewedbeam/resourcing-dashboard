VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Confirmation password for the "clear data" actions on the Settings page.
# This is a client-side gate only (the app has no login), not real access
# control - it ships inside the built JS bundle. Defaults to "clear-data".
VITE_CLEAR_DATA_PASSWORD=choose-a-password
# Password to unlock editing anywhere in the app (view-only otherwise).
# Same client-side-gate caveat as above. Defaults to "edit-access".
VITE_EDIT_PASSWORD=choose-a-password
